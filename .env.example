# ========================
# GitHub OAuth
# ========================
# Used by NextAuth (frontend) — the code reads the v5 AUTH_* names below, not the
# legacy NEXTAUTH_*/GITHUB_CLIENT_* names.
AUTH_GITHUB_ID=your_github_oauth_app_client_id
AUTH_GITHUB_SECRET=your_github_oauth_app_client_secret

# ========================
# Google AI (Gemini via ADK)
# ========================
GOOGLE_API_KEY=your_google_api_key

# ========================
# NextAuth.js (v5)
# ========================
AUTH_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_generate_with_openssl_rand_base64_32

# ========================
# Database (PostgreSQL)
# ========================
# Not read at request time yet — see ARCHITECTURE.md's Phase 2 persistence section.
DATABASE_URL=postgresql+asyncpg://agentcommit:agentcommit@localhost:5432/agentcommit
POSTGRES_USER=agentcommit
POSTGRES_PASSWORD=agentcommit
POSTGRES_DB=agentcommit

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Backend
# ========================
BACKEND_URL=http://localhost:8000
# Must be valid JSON — pydantic-settings parses list-typed settings as JSON, not
# comma-separated strings.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ========================
# MCP Servers
# ========================
# Not wired into any agent yet — see ARCHITECTURE.md's Phase 2 MCP section.
GITHUB_MCP_TOKEN=your_github_personal_access_token
