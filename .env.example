# ========================
# GitHub OAuth
# ========================
# Used by NextAuth (frontend) — the code reads the v5 AUTH_* names below, not the
# legacy NEXTAUTH_*/GITHUB_CLIENT_* names.
AUTH_GITHUB_ID=your_github_oauth_app_client_id
AUTH_GITHUB_SECRET=your_github_oauth_app_client_secret

# ========================
# Google AI (Gemini via ADK)
# ========================
GOOGLE_API_KEY=your_google_api_key

# ========================
# NextAuth.js (v5)
# ========================
AUTH_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_generate_with_openssl_rand_base64_32

# ========================
# Database (PostgreSQL)
# ========================
# Used by the saved-issues API and profile-analysis persistence — see
# ARCHITECTURE.md §5. Run `alembic upgrade head` (from backend/) after the
# database is up; nothing runs the migration for you.
DATABASE_URL=postgresql+asyncpg://agentcommit:agentcommit@localhost:5432/agentcommit
POSTGRES_USER=agentcommit
POSTGRES_PASSWORD=agentcommit
POSTGRES_DB=agentcommit
# Host port for the container. Change this (and the port in DATABASE_URL above) if
# you already run PostgreSQL locally — a native install binds 127.0.0.1:5432 more
# specifically than Docker's wildcard, so it wins every connection while the
# container still reports healthy.
POSTGRES_PORT=5432

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Backend
# ========================
BACKEND_URL=http://localhost:8000
# Must be valid JSON — pydantic-settings parses list-typed settings as JSON, not
# comma-separated strings.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ========================
# MCP Servers
# ========================
# Used by the Implementation Planner Agent to browse repository files via the
# GitHub MCP server — see ARCHITECTURE.md §5. Optional: the planner falls back
# to REST-only tools if this subprocess is unavailable.
GITHUB_MCP_TOKEN=your_github_personal_access_token
