# Frontend Environment Variables

# Backend API origin, used by next.config.ts to proxy /api/proxy/* requests.
# Defaults to http://127.0.0.1:8000 for local development if unset.
BACKEND_API_URL=http://127.0.0.1:8000

# NextAuth (v5) — the code reads these exact names (see src/lib/auth.ts).
AUTH_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_generate_with_openssl_rand_base64_32
AUTH_GITHUB_ID=your_github_oauth_app_client_id
AUTH_GITHUB_SECRET=your_github_oauth_app_client_secret
